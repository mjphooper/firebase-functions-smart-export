{
  "name": "firebase-functions-smart-export",
  "description": "Smart, dynamic exporting to speed up Firebase Functions. Fully ESM compatible",
  "author": "Matt Hooper <email goes here> (matthooper.dev)",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "firebase",
    "functions",
    "cold",
    "start",
    "codegen",
    "dynamic",
    "export",
    "fast",
    "speed",
    "esm"
  ],
  "files": [
    "bin/",
    "lib/"
  ],
  "exports": {
    ".": {
      "types": "./lib/public_api.d.ts",
      "default": "./lib/public_api.js"
    }
  },
  "homepage": "https://<organization/user>.github.io/<project>/",
  "repository": "https://github.com/<organization/user>/<project>.git",
  "bin": {
    "ffse": "./bin/ffse.js",
    "firebase-functions-smart-export": "./bin/ffse.js"
  },
  "scripts": {
    "build": "rm -r -f lib && tsc -p tsconfig.build.json",
    "test": "npm run build && mocha",
    "coverage": "npm run build && c8 --include=src mocha",
    "lint": "eslint .",
    "typecheck": "npm run build && tsc -p tsconfig.json"
  },
  "type": "module",
  "dependencies": {
    "@babel/helper-validator-identifier": "^8.0.6",
    "chalk": "^5.6.2",
    "change-case": "^5.4.4",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "indent-string": "^5.0.0",
    "slash": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.1",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.32.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "sinon": "^21.1.2",
    "sinon-chai": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "peerDependencies": {
    "firebase-functions": "^7.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
