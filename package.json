{
  "name": "firebase-functions-smart-export",
  "description": "Smart, dynamic exporting to speed up Firebase Functions. Fully ESM compatible",
  "author": "Matt Hooper <email goes here> (matthooper.dev)",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "firebase",
    "functions",
    "cold",
    "start",
    "codegen",
    "dynamic",
    "export",
    "fast",
    "speed",
    "esm"
  ],
  "files": [
    "bin/",
    "cli/",
    "shared/",
    "runtime.bundle.js"
  ],
  "homepage": "https://<organization/user>.github.io/<project>/",
  "repository": "https://github.com/<organization/user>/<project>.git",
  "bin": {
    "ffse": "./bin/ffse.js",
    "firebase-functions-smart-export": "./bin/ffse.js"
  },
  "scripts": {
    "build": "rm -r -f cli && rm -r -f shared && rm -f runtime.bundle.js && tsc -p tsconfig.build.json && npm run esbuild:src",
    "esbuild:src": "esbuild src/runtime/index.ts --bundle --platform=node --target=node18 --outfile=runtime.bundle.js --format=esm --external:firebase-functions",
    "pretest": "npm run build",
    "test": "mocha"
  },
  "type": "module",
  "dependencies": {
    "change-case": "^5.4.4",
    "fast-glob": "^3.3.3",
    "slash": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.1",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "dset": "^3.1.4",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "mocha": "^11.7.5",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "peerDependencies": {
    "firebase-functions": "^7.0.0"
  },
  "license": "MIT"
}
