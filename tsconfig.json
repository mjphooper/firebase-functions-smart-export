// Editor + test config: type-checks all source and tests, emits nothing.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "sourceMap": false,
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "src",
    "test"
  ]
}